# ===========================================
# Meat Accounting — Production Environment
# ===========================================
# Скопируйте в .env и заполните значениями
# cp .env.example .env

# --- Database -------------------------------------------------
# PostgreSQL async URL (asyncpg driver)
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://meat_user:CHANGE_ME@localhost:5432/meat_accounting

# --- Security -------------------------------------------------
# Сгенерируйте: openssl rand -hex 32
# ОБЯЗАТЕЛЬНО измените в продакшене!
SECRET_KEY=

# Алгоритм JWT (не меняйте)
ALGORITHM=HS256

# Время жизни токена (часы)
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- CORS -----------------------------------------------------
# Разрешённые домены для фронтенда (через запятую, БЕЗ пробелов)
# Пример: ALLOWED_ORIGINS=https://meat.example.ru,https://www.meat.example.ru
ALLOWED_ORIGINS=https://meat-uchet.ru,https://www.meat-uchet.ru

# --- App ------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Часовой пояс
TIMEZONE=Europe/Moscow

# --- Logging --------------------------------------------------
# Уровень: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JSON логи (true/false) — для продакшена лучше true
LOG_JSON=true